{
  "name": "tanmay-site",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs && node scripts/prepare-release.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run build && npm test",
    "preview": "node scripts/preview-built.mjs",
    "browser:setup": "npm install --no-save playwright-core@^1.56.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.11"
  }
}
