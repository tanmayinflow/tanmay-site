          "before": "   const flow=escaped||reduced.matches||innerWidth>=900||viewport<560||parseFloat(getComputedStyle(document.documentElement).fontSize)>20||(visualViewport?.scale||1)>1.01;\n",
          "after": "   const stableViewport=smallViewport.getBoundingClientRect().height;\n   const handstandAvailable=stableViewport-24-(dock?.height||0)-12-2;\n   const flow=escaped||reduced.matches||innerWidth>=900||parseFloat(getComputedStyle(document.documentElement).fontSize)>20||(visualViewport?.scale||1)>1.01;\n"
